{
  "name": "@johnnywu/pi-config",
  "version": "0.2.1",
  "description": "Pi extensions from jwu/pi-config",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwu/pi-config.git"
  },
  "engines": { "node": ">=22.19.0" },
  "files": ["extensions/", "extensions-optional/", "docs/"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "typecheck": "bun tsc --noEmit --ignoreDeprecations 6.0",
    "test": "bun test",
    "lint": "bun run format:check && bun run typecheck && bun run test",
    "format": "prettier --write 'extensions/**/*.ts' 'extensions-optional/**/*.ts'",
    "format:check": "prettier --check 'extensions/**/*.ts' 'extensions-optional/**/*.ts'"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@johnnywu/pi-agent-profiles": "0.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
