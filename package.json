{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun tsc --noEmit --ignoreDeprecations 6.0",
    "test": "bun test",
    "lint": "bun run format:check && bun run typecheck && bun run test",
    "format": "prettier --write 'extensions/**/*.ts' 'extensions-optional/**/*.ts'",
    "format:check": "prettier --check 'extensions/**/*.ts' 'extensions-optional/**/*.ts'"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
